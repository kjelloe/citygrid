# Copy to tools/deploy.env (gitignored — your box, your key) and fill in.
DEPLOY="citygrid@citygrid.kjell.today"
APP="/opt/citygrid"
SSH_OPTS="-i ~/.ssh/id_ed25519_yourkey -p 22"
SERVICE="citygrid"
PUBLIC_URL="https://citygrid.kjell.today"
# The port claimed in the box's hosting document, matching the systemd unit.
PORT="8133"
